{
  "$schema": "http://json.schemastore.org/template",
  "author": "Launchpad Platform Team",
  "classifications": [ "Web", "API", "Solution" ],
  "identity": "Launchpad.Api.Template",
  "name": "Launchpad .NET API",
  "shortName": "launchpad-api",
  "description": "Minimal API with vertical slices, tests, governance files and GitHub Actions.",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Launchpad",
  "preferNameDirectory": true,
  "symbols": {
    "aspire": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Adds an Aspire AppHost and the ServiceDefaults project."
    },
    "worker": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Adds a background worker project."
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(!aspire)",
          "exclude": [ "src/Launchpad.AppHost/**", "src/Launchpad.ServiceDefaults/**" ]
        },
        {
          "condition": "(!worker)",
          "exclude": [ "src/Launchpad.Worker/**" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "src/Launchpad.slnx" }
  ]
}
